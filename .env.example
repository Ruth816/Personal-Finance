# Copy this file to .env.local for running on your computer,
# and add the same three values in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → "anon public" key (safe to expose in the browser)
SUPABASE_ANON_KEY=

# Optional. Anthropic Console → API keys. Turns on "Scan a receipt photo".
# Leave empty to hide the button. Each scan is billed to this key.
ANTHROPIC_API_KEY=
